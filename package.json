{
  "name": "pictureline-inventory-cash-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Tracks actual cash/credit-card spend on Material Inventory from QuickBooks Online",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "intuit-oauth": "^4.2.0",
    "node-quickbooks": "^2.0.46",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
